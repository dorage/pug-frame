{
	"name": "pug-frame-obsidian",
	"version": "0.1.0",
	"description": "Obsidian에서 pug-frame 코드블록을 pug-frame-canvas로 렌더링하는 플러그인",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"bump": "bun scripts/bump-version.ts",
		"check-version": "bun scripts/check-version.ts"
	},
	"keywords": [],
